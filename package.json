    "preversion": "rm -rf ./dist && npm run build && npm run lint && npm run test",
    "postversion": "npm publish && git push --follow-tags"
  },
  "author": "antonk52",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonk52/make-me-a-content.git"
  },
  "keywords": [
    "content",
    "generation"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "prettier": "^2.8.8",
    "rome": "^12.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
