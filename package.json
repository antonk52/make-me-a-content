{
  "name": "make-me-a-content",
  "version": "0.3.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mmac-check": "./dist/cli.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "rome check ./src vitest.config.ts",
    "lint:fix": "rome check ./src vitest.config.ts --apply",
